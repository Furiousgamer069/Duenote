# Copy this file to ".env" and paste your real key there.
# Get a free key at https://aistudio.google.com/apikey
# Without a key, DueNote still works in Sample replay mode.
GEMINI_API_KEY=paste-your-key-here

# Optional: Gemma models to try in order (comma separated)
GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
